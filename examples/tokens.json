{
  "color": {
    "$type": "color",
    "neutral": {
      "50": { "$value": "#f5f7f9" },
      "900": { "$value": "#1a1f24" }
    },
    "brand": {
      "$value": "#1784bd",
      "$extensions": { "modes": { "dark": "#5cb8e8" } }
    },
    "surface": {
      "$value": "#ffffff",
      "$extensions": { "modes": { "dark": "#0f1720" } }
    },
    "text": {
      "$value": "{color.neutral.900}",
      "$extensions": { "modes": { "dark": "{color.neutral.50}" } }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "4": { "$value": "16px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "{space.2}" }
  },
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": ["Inter", "system-ui", "sans-serif"] },
    "arabic": { "$value": ["Noto Sans Arabic", "Tahoma", "sans-serif"] }
  },
  "motion": {
    "$type": "duration",
    "fast": { "$value": { "value": 120, "unit": "ms" } }
  }
}
